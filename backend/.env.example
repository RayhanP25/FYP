# Copy to .env and fill in your own values. Never commit .env or share its values.

# MongoDB Atlas (add this PC's IP under Network Access in Atlas)
DATABASE_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>"
DATABASE_NAME="sportPoseDB"

JWT_SECRET_KEY='generate-a-long-random-secret'
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Video storage: Cloudflare R2 through the MinIO client (endpoint without https://)
MINIO_API=<account-id>.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=<r2-access-key-id>
MINIO_SECRET_KEY=<r2-secret-access-key>
# MINIO_BUCKET=sport-pose-videos      # only if using a non-default bucket

# Cameras (two USB cameras, left and right). Run `python probe_cams.py` with the backend
# stopped to see which index is which; with a built-in laptop camera the USB ones are usually 1 and 2.
CAMERA_LEFT_INDEX=1
CAMERA_RIGHT_INDEX=2
CAMERA_WIDTH=2560
CAMERA_HEIGHT=1440
CAMERA_FPS=30
CAMERA_OPEN_TIMEOUT_SEC=120     # 2K cameras can take a while to open
# CAMERA_API=msmf               # Windows capture backend: msmf (default) or dshow
# PREVIEW_FPS=15                # live preview rate/size (kept lower so it doesn't starve capture)
# PREVIEW_SCALE=0.5

# Pose estimation (ViTPose)
POSE_DET_EVERY=10             # re-run the person detector every N frames; 1 = every frame (slower)
POSE_FP16=1                   # half precision on the GPU: much faster, practically the same keypoints. Default is off
# POSE_DEVICE=cpu             # unset = auto (cuda:0 if a GPU is available)
# POSE_MIN_CONF=0.3           # below this a keypoint is not drawn / used
# POSE_SURE_CONF=0.8          # MIN..SURE draws as "uncertain" (yellow), >= SURE is solid
# POSE_TRIANGULATE_CONF=0.5   # stereo: a joint must beat this in BOTH views to get a 3D point
