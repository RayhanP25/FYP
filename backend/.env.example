# Copy to .env and fill in your own values.

DATBASE_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>"
DATABASE_NAME="sportPoseDB"

JWT_SECRET_KEY='generate-a-long-random-secret'
ACCESS_TOKEN_EXPIRE_MINUTES=30

MINIO_API=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=sport-pose-videos      # only if using a non-default bucket

# Camera indices -- with a laptop built-in cam + 2 USB webcams the USBs are
# often 1 and 2. curl http://localhost:8000/api/camera/list to see detected ones.
CAMERA_LEFT_INDEX=0
CAMERA_RIGHT_INDEX=2
CAMERA_OPEN_TIMEOUT_SEC=30

# CAMERA_API=msmf                   # Windows capture backend: msmf (default) or dshow
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
# CAMERA_FPS=30
# PREVIEW_FPS=15                  # live preview rate/size (kept lower so it doesn't starve capture)
# PREVIEW_SCALE=0.5

# Pose estimation (ViTPose)
# POSE_DEVICE=cpu               # unset = auto (cuda:0 if a GPU is available)
POSE_DET_EVERY=10             # re-run person detector every N frames; 1 = every frame (slower)
# POSE_MIN_CONF=0.3           # below this a keypoint is not drawn / used
# POSE_SURE_CONF=0.8          # MIN..SURE draws as "uncertain" (yellow), >= SURE is solid
# POSE_TRIANGULATE_CONF=0.5   # stereo: a joint must beat this in BOTH views to get a 3D point
